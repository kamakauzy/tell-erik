        "summary": "Version unread.",
    }


def channel_for(method: Optional[str]) -> str:
    if method in ("assembly", "resource-query", "html-comment"):
        return "server"
    if method == "script-banner":
        return "runtime"
    if method:
        return "asset"
    return "none"


def asset_state_for(method: Optional[str], product: Optional[str], version: Optional[str], verdicts: Sequence[dict]) -> str:
    if method == "file-banner":
        return "confirmed"
    if channel_for(method) != "asset" or not product or not version:
        return "unchecked"
    key = product_key(version)
    related = [item for item in verdicts if item.get("product") == product and product_key(item.get("version") or "") == key]
    if not related:
        return "unchecked"
    if any(item.get("state") == "confirmed" for item in related):
        return "confirmed"
    if any(item.get("state") == "rejected" for item in related):
        return "rejected"
    return "unconfirmed"


def build_headline(hits: Sequence[dict], verdicts: Optional[Sequence[dict]] = None) -> dict:
    verdicts = list(verdicts or [])
    if not hits:
        return empty_headline()
    ajax = [hit for hit in hits if hit["product"] == "aspnet-ajax"]
    pool = ajax or list(hits)
    keys = []
    for hit in pool:
        key = product_key(hit["version"])
        if key and key not in keys:
            keys.append(key)
    ranked = sorted(pool, key=lambda hit: (PRODUCT_RANK.get(hit["product"], 9), METHOD_RANK.get(hit["method"], 9)))
    primary = product_key(ranked[0]["version"]) if ranked else (keys[0] if keys else None)
    same = [hit for hit in ranked if product_key(hit["version"]) == primary]
    detailed = next((hit for hit in same if hit["version"].count(".") >= 3), same[0] if same else ranked[0])
    conflict = len(keys) > 1
    alternates = [key for key in keys if key != primary]
    method = detailed["method"]
    version = detailed["version"]
    product = detailed["product"]
    channel = channel_for(method)
    asset_state = asset_state_for(method, product, version, verdicts)
    label = PRODUCT_LABEL.get(product, "Telerik")
    method_name = METHOD_LABEL.get(method, method).lower()
    if conflict:
        summary = "Conflicting %s builds: %s. Headline follows the %s." % (label, ", ".join(keys), method_name)
    elif method == "ajax-cdn" and asset_state == "confirmed":
        summary = "%s %s, read from the AJAX CDN path. The stylesheet returned a Telerik skin." % (label, version)
    elif method == "ajax-cdn" and asset_state == "rejected":
        summary = "%s %s, read from the AJAX CDN path. That URL did not return a skin." % (label, version)
    elif method == "ajax-cdn" and asset_state == "unconfirmed":
        summary = "%s %s, read from the AJAX CDN path. The file check was inconclusive." % (label, version)
    elif method == "ajax-cdn":
        summary = "%s %s, read from the AJAX CDN path." % (label, version)
    elif method == "html-comment":
        summary = "%s %s, read from the HTML version comment." % (label, version)
    elif method == "file-banner":
        summary = "%s %s, read from the script file banner." % (label, version)
    else:
        summary = "%s %s, read from %s." % (label, version, method_name)
    comparable = channel == "server" or channel == "runtime" or (channel == "asset" and asset_state == "confirmed")
    basis = ""
    if comparable and version and product == "aspnet-ajax":
        if channel == "server":
            basis = "Compared to the server-stated build."
        elif channel == "asset":
            basis = "Compared to the confirmed skin. The server build was not in the page."
        else:
            basis = "Compared to the script banner."
    return {
        "version": version,
        "product": product,
        "productKey": primary,
        "method": method,
        "channel": channel,
        "assetState": asset_state,
        "basis": basis,
        "conflict": conflict,
        "alternates": alternates,
        "summary": summary,
    }


