def fetch_asset(opener, start: str, timeout: float) -> Tuple[int, str, str]:
    current = start
    for _ in range(3):
        split = urllib.parse.urlsplit(current)
        host = (split.hostname or "").lower()
        if host not in ASSET_HOSTS:
            return 0, "", ""
        try:
            infos = socket.getaddrinfo(host, None)
        except socket.gaierror:
            return 0, "", ""
        if any(is_blocked_ip(info[4][0], True) for info in infos):
            return 0, "", ""
        try:
            status, body, headers, _ = fetch_once(
                opener,
                current,
                "GET",
                None,
                {"User-Agent": SCANNER_UA, "Accept": "text/css,text/javascript,*/*;q=0.1"},
                timeout,
                ASSET_CAP,
            )
        except (urllib.error.URLError, TimeoutError, socket.timeout, OSError):
            return 0, "", ""
        if 300 <= status < 400:
            location = header_get(headers, "Location")
            if not location:
                return status, "", ""
            current = urllib.parse.urljoin(current, location)
            continue
        return status, header_get(headers, "Content-Type") or "", body
    return 0, "", ""


