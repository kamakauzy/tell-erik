def asset_targets(body: str, page_url: str) -> List[dict]:
    raw = []
    seen = set()
    for match in ATTR_URL_RE.finditer(body):
        value = match.group(1).replace("&", "&")
        try:
            absolute = urllib.parse.urljoin(page_url, value)
            split = urllib.parse.urlsplit(absolute)
        except ValueError:
            continue
        host = (split.hostname or "").lower()
        if host not in ASSET_HOSTS:
            continue
        href = urllib.parse.urlunsplit((split.scheme, split.netloc, split.path, split.query, ""))
        if href in seen:
            continue
        if host == "d35islomi5rx1v.cloudfront.net":
            found = AJAX_ASSET_RE.search(split.path)
            if not found:
                continue
            seen.add(href)
            raw.append(
                {
                    "url": href,
                    "version": found.group(1),
                    "product": "aspnet-ajax",
                    "kind": "css" if re.search(r"\.css(?:$|\?)", split.path, re.I) else "js",
                }
            )
            continue
        found = KENDO_ASSET_RE.search(split.path)
        if not found:
            continue
        seen.add(href)
        raw.append(
            {
                "url": href,
                "version": found.group(1),
                "product": "kendo",
                "kind": "js" if re.search(r"\.js(?:$|\?)", split.path, re.I) else "css",
            }
        )
    ajax_css = {product_key(item["version"]) for item in raw if item["product"] == "aspnet-ajax" and item["kind"] == "css"}
    filtered = [
        item
        for item in raw
        if not (item["product"] == "aspnet-ajax" and item["kind"] == "js" and product_key(item["version"]) in ajax_css)
    ]

    def score(item: dict) -> int:
        if item["product"] == "kendo":
            return 0 if item["kind"] == "js" else 1
        return 0 if item["kind"] == "css" else 1

    filtered.sort(key=score)
    picked = []
    picked_keys = set()
    for item in filtered:
        key = "%s|%s" % (item["product"], product_key(item["version"]))
        if key in picked_keys:
            continue
        picked_keys.add(key)
        picked.append(item)
        if len(picked) >= 4:
            break
    return picked


def confirm_asset(target: dict, status: int, content_type: str, body: str) -> dict:
    sample = body[:4096]
    content = (content_type or "").lower()
    verdict = {
        "url": target["url"],
        "version": target["version"],
        "product": target["product"],
        "bannerVersion": None,
    }
    if status == 0:
        verdict.update(state="unconfirmed", detail="No response")
        return verdict
    if status in (404, 410):
        verdict.update(state="rejected", detail="Not found")
        return verdict
    if HTML_BODY_RE.search(sample):
        verdict.update(state="rejected", detail="The response was HTML.")
        return verdict
    if target["product"] == "aspnet-ajax":
        css_type = "css" in content or "text/plain" in content or content == ""
        if status == 200 and css_type and RAD_MARKER_RE.search(sample):
            verdict.update(state="confirmed", detail="Stylesheet returned a Telerik skin.")
            return verdict
        if status == 200:
            verdict.update(state="rejected", detail="The body was not a Telerik skin.")
            return verdict
        verdict.update(state="unconfirmed", detail="HTTP %d" % status)
        return verdict
    banner = FILE_BANNER_RE.search(sample)
    if status == 200 and banner:
        banner_version = banner.group(1)
        verdict["bannerVersion"] = banner_version
        if product_key(banner_version) == product_key(target["version"]):
            verdict.update(state="confirmed", detail="Script banner matches the path.")
        else:
            verdict.update(state="rejected", detail="Script banner is %s." % banner_version)
        return verdict
    if status == 200 and (("css" in content) or target["kind"] == "css") and KENDO_RULE_RE.search(sample):
        verdict.update(state="confirmed", detail="Stylesheet returned Kendo rules.")
        return verdict
    if status == 200:
        verdict.update(state="rejected", detail="The body did not carry a Kendo banner.")
        return verdict
    verdict.update(state="unconfirmed", detail="HTTP %d" % status)
    return verdict


def version_file_urls(page_url: str, html: str) -> List[str]:
    origin = urllib.parse.urlsplit(page_url)
    origin_key = (origin.scheme, origin.netloc)
    urls = []
    seen = set()
    for match in ATTR_URL_RE.finditer(html):
        value = match.group(1).replace("&", "&")
        if re.match(r"^(data|javascript|mailto):", value, re.I):
            continue
        absolute = urllib.parse.urljoin(page_url, value)
        split = urllib.parse.urlsplit(absolute)
        host = (split.hostname or "").lower()
        if (split.scheme, split.netloc) != origin_key or host in ASSET_HOSTS:
            continue
        blob = ("%s %s" % (split.path, split.query)).lower()
        if not re.search(r"telerik|kendo|webresource\.axd|scriptresource\.axd|dialoghandler", blob):
            continue
        href = urllib.parse.urlunsplit((split.scheme, split.netloc, split.path, split.query, ""))
        if href in seen or href == page_url:
            continue
        seen.add(href)
        urls.append(href)
        if len(urls) >= 5:
            break
    return urls


def login_note(page_url: str, body: str) -> Optional[str]:
    path = urllib.parse.urlsplit(page_url).path.lower()
    path_login = re.search(r"/(login|logon|signin|sign-in)(/|\.|$)", path) is not None
    password = re.search(r"""type=["']password["']""", body, re.I) is not None
    if not path_login and not password:
        return None
    suite = re.search(r"Telerik\.Web\.UI|RadScriptManager|RadGrid|RadAjax|kendo", body, re.I) is not None
    if suite:
        return "This response is a login form. The suite is referenced on the page."
    return "This response is a login form. The application session is not on this read."


def apply_presence(headline: dict, signals: Sequence[str], handlers: Sequence[dict]) -> dict:
