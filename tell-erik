        rows.append(
            {
                "id": advisory["id"],
                "title": advisory["title"],
                "status": "unplaced",
                "detail": "%s. Build not read. %s" % (library, advisory["detail"]),
                "kev": bool(advisory.get("kev")),
                "epss": advisory.get("epss"),
            }
        )
    return rows


def build_notes(headline: dict, handlers: Sequence[dict], signals: Sequence[str]) -> List[str]:
    notes = []
    rau = next((row for row in handlers if row["id"] == "rau"), None)
    present = any(row["state"] == "present" for row in handlers)
    if rau and rau["state"] == "present":
        notes.append(
            "RadAsyncUpload answered GET. The registration string uses the vendor spelling “succesfully”."
        )
    dialog = next((row for row in handlers if row["id"] == "dialog"), None)
    if headline.get("product") == "kendo" and rau and rau["state"] == "present" and dialog and dialog["state"] == "present":
        notes.append("RadAsyncUpload and DialogHandler answered. The ASP.NET AJAX build was not in the page.")
    if not headline.get("version") and present:
        notes.append(
            "Handler answered. EnableHandlerEncryption encrypts WebResource URLs and drops the version comment. "
            "The build is on the CDN path, or on a page that still prints the comment."
        )
    if any(row["detail"] in ("HTTP 401", "HTTP 403") for row in handlers):
        notes.append("A path returned 401 or 403. Pass the application cookie or a form login and run again.")
    if headline.get("conflict") and headline.get("channel") == "server":
        notes.append("The headline follows the server-stated build. Another build was also on the page.")
    elif headline.get("conflict"):
        notes.append("More than one product build appeared.")
    if headline.get("method") == "ajax-cdn" and headline.get("assetState") == "confirmed":
        notes.append(
            "The CDN file returned a Telerik skin. The CSS does not repeat the version. The product build is the first three numbers."
        )
    elif headline.get("method") == "ajax-cdn" and headline.get("assetState") == "rejected":
        notes.append("The CDN URL did not return a skin. The path is a label, so the published ranges were not applied.")
    elif headline.get("method") == "ajax-cdn" and headline.get("assetState") == "unconfirmed":
        notes.append("The CDN file check was inconclusive, so the published ranges were not applied.")
    elif headline.get("method") == "ajax-cdn":
        notes.append("The CDN path omits the assembly framework suffix (.40, .45, .462). The product build is the first three numbers.")
    if any("encrypted d parameter" in signal for signal in signals) and headline.get("method") != "html-comment":
        notes.append("WebResource.axd carries an encrypted query. The suite is on the page.")
    if not headline.get("version") and not present and not signals:
        notes.append("Clean miss on the probed paths.")
    return notes


def directory_bases(page_url: str, walk: bool) -> List[str]:
    parts = urllib.parse.urlsplit(page_url)
    path = parts.path or "/"
    if not path.endswith("/"):
        path = path[: path.rfind("/") + 1] or "/"
    bases = []
    seen = set()
    limit = 6 if walk else 1
    while len(bases) < limit:
        base = "%s://%s%s" % (parts.scheme, parts.netloc, path)
        if base not in seen:
            seen.add(base)
            bases.append(base)
        if not walk or path == "/":
            break
        trimmed = path[:-1]
        slash = trimmed.rfind("/")
        path = "/" if slash <= 0 else trimmed[: slash + 1]
    return bases


def referenced_bases(page_url: str, html: str) -> List[str]:
    bases = []
    seen = set()
    origin = urllib.parse.urlsplit(page_url)
    origin_key = (origin.scheme, origin.netloc)
    for match in REF_RE.finditer(html):
        raw = match.group(1).replace("&amp;", "&")
        resolved = urllib.parse.urljoin(page_url, raw)
        split = urllib.parse.urlsplit(resolved)
        if (split.scheme, split.netloc) != origin_key:
            continue
        path = split.path[: split.path.rfind("/") + 1] or "/"
        base = "%s://%s%s" % (split.scheme, split.netloc, path)
        if base not in seen:
            seen.add(base)
            bases.append(base)
    return bases


def ipv4_to_int(ip: str) -> Optional[int]:
    parts = ip.split(".")
    if len(parts) != 4:
        return None
    value = 0
    for part in parts:
        if not part.isdigit():
            return None
        number = int(part)
        if number > 255:
            return None
        value = value * 256 + number
    return value


def is_blocked_ip(ip: str, block_loopback: bool) -> bool:
    host = ip.lower().strip("[]")
    if host == "fd00:ec2::254":
        return True
    if block_loopback and host in ("::1", "0:0:0:0:0:0:0:1"):
        return True
    if ":" in host:
        return host.startswith("fe80:")
    if host == "100.100.100.200":
        return True
    addr = ipv4_to_int(host)
    if addr is None:
        return False

    def cidr(base: str, bits: int) -> bool:
        network = ipv4_to_int(base)
        if network is None:
            return False
        mask = 0 if bits == 0 else ((~0 << (32 - bits)) & 0xFFFFFFFF)
        return (addr & mask) == (network & mask)

    if cidr("169.254.0.0", 16) or cidr("0.0.0.0", 8):
        return True
    if block_loopback and cidr("127.0.0.0", 8):
        return True
    return False


def check_url(raw: str, block_loopback: bool) -> urllib.parse.SplitResult:
    split = urllib.parse.urlsplit(raw.strip())
    if split.scheme not in ("http", "https") or not split.netloc:
        raise ValueError("Target must be an http or https URL.")
    if split.username or split.password:
        raise ValueError("Put credentials in the auth flags, not in the URL.")
    host = (split.hostname or "").lower().rstrip(".")
    if host in METADATA_HOSTS:
        raise ValueError("That host is a cloud metadata name and is blocked.")
    if is_blocked_ip(host, block_loopback):
        raise ValueError("That address is link-local, metadata, or otherwise blocked.")
    try:
        infos = socket.getaddrinfo(host, None)
    except socket.gaierror as exc:
        raise ValueError("Could not resolve %s." % host) from exc
    for info in infos:
        address = info[4][0]
        if is_blocked_ip(address, block_loopback):
            raise ValueError("That host resolves to a blocked address.")
    return split


class Response:
    def __init__(self, status: int, body: str, headers, final_url: str, off_host: bool) -> None:
        self.status = status
        self.body = body
        self.headers = headers
        self.final_url = final_url
        self.off_host = off_host


def build_opener(proxy: Optional[str], insecure: bool) -> urllib.request.OpenerDirector:
    opener = urllib.request.OpenerDirector()
    if proxy:
        opener.add_handler(urllib.request.ProxyHandler({"http": proxy, "https": proxy}))
    context = ssl._create_unverified_context() if insecure else ssl.create_default_context()
    opener.add_handler(urllib.request.HTTPHandler())
    opener.add_handler(urllib.request.HTTPSHandler(context=context))
    # Without this, a non-2xx response raises KeyError('http') instead of HTTPError.
    opener.add_handler(urllib.request.HTTPDefaultErrorHandler())
    opener.add_handler(urllib.request.HTTPErrorProcessor())
    return opener


def header_get(headers, name: str) -> Optional[str]:
    if headers is None:
        return None
    value = headers.get(name)
    return value if value else None


def set_cookies(headers) -> List[str]:
    if headers is None:
        return []
    values = headers.get_all("Set-Cookie") if hasattr(headers, "get_all") else None
    if values:
        return list(values)
    single = headers.get("Set-Cookie")
    return [single] if single else []


def absorb(jar: Dict[str, str], locked: set, lines: Sequence[str]) -> None:
    for line in lines:
        pair = line.split(";", 1)[0]
        if "=" not in pair:
            continue
        name, value = pair.split("=", 1)
        name = name.strip()
        if not name or name in locked:
            continue
        jar[name] = value.strip()


def cookie_header(jar: Dict[str, str]) -> str:
    return "; ".join("%s=%s" % item for item in jar.items())


def fetch_once(opener, url: str, method: str, data: Optional[bytes], headers: Dict[str, str], timeout: float, limit: int = MAX_BODY) -> Tuple[int, str, object, str]:
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with opener.open(request, timeout=timeout) as response:
            raw = response.read(limit + 1)
            body = raw[:limit].decode("utf-8", "replace")
            return response.status, body, response.headers, response.geturl()
    except urllib.error.HTTPError as exc:
        try:
            raw = exc.read(limit + 1) if exc.fp else b""
        finally:
            exc.close()
        body = raw[:limit].decode("utf-8", "replace")
        return exc.code, body, exc.headers, url


def fetch_same_origin(opener, start: str, method: str, data: Optional[bytes], headers: Dict[str, str], jar: Dict[str, str], locked: set, timeout: float) -> Response:
    origin = urllib.parse.urlsplit(start)
    origin_key = (origin.scheme, origin.netloc)
    current = start
    verb = method
    payload = data
    last_status = 0
    last_body = ""
    last_headers = None
    for _ in range(5):
        sent = dict(headers)
        cookie = cookie_header(jar)
        if cookie:
            sent["Cookie"] = cookie
        status, body, response_headers, _ = fetch_once(opener, current, verb, payload, sent, timeout)
        absorb(jar, locked, set_cookies(response_headers))
        last_status, last_body, last_headers = status, body, response_headers
        if status < 300 or status >= 400:
            return Response(status, body, response_headers, current, False)
        location = header_get(response_headers, "Location")
        if not location:
            return Response(status, body, response_headers, current, False)
        nxt = urllib.parse.urljoin(current, location)
        split = urllib.parse.urlsplit(nxt)
        if (split.scheme, split.netloc) != origin_key:
            return Response(status, body, response_headers, current, True)
        current = nxt
        if verb not in ("GET", "HEAD") and status in (301, 302, 303):
            verb = "GET"
            payload = None
    return Response(last_status, last_body, last_headers, current, False)


def parse_header_lines(raw: str) -> Dict[str, str]:
    headers = {}
    for line in raw.splitlines():
        if ":" not in line:
            continue
        name, value = line.split(":", 1)
        name = name.strip()
        value = value.strip()
        if not name or name.lower() in ("host", "content-length", "transfer-encoding", "connection"):
            continue
        headers[name] = value
    return headers


def seed_jar(cookie: str) -> Tuple[Dict[str, str], set]:
    jar: Dict[str, str] = {}
    locked = set()
    for part in cookie.split(";"):
        if "=" not in part:
            continue
        name, value = part.split("=", 1)
        name = name.strip()
        if not name:
            continue
        jar[name] = value.strip()
        locked.add(name)
    return jar, locked


def prefer_handlers(rows: Sequence[dict]) -> List[dict]:
    chosen: Dict[str, dict] = {}
    for row in rows:
        previous = chosen.get(row["id"])
        if previous is None or (previous["state"] != "present" and row["state"] == "present"):
            chosen[row["id"]] = row
    return list(chosen.values())


def scan_one(args, url: str) -> dict:
    started = time.time()
    try:
        check_url(url, block_loopback=False)
    except ValueError as exc:
        return {"ok": False, "error": str(exc), "target": url, "elapsedMs": 0}

    if args.bearer and args.basic:
        return {"ok": False, "error": "Bearer and basic auth both set the Authorization header. Use one.", "target": url}

    opener = build_opener(args.proxy, args.insecure)
    jar, locked = seed_jar(args.cookie or "")
    headers = {
        "User-Agent": BROWSER_UA if not args.scanner_ua else SCANNER_UA,
        "Accept": "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.8",
    }
    headers.update(parse_header_lines(args.header_text or ""))
    if args.bearer:
        headers["Authorization"] = "Bearer " + args.bearer
    elif args.basic:
        import base64

        headers["Authorization"] = "Basic " + base64.b64encode(args.basic.encode()).decode()

    requests = []
    environment = {}
    timeout = args.timeout
    try:
        if args.form_url:
            check_url(args.form_url, block_loopback=False)
            if not args.form_user:
                return {"ok": False, "error": "Form login needs a username.", "target": url}
            form = urllib.parse.urlencode(
                {
                    args.form_user_field or "username": args.form_user,
                    args.form_pass_field or "password": args.form_password or "",
                }
            ).encode()
            login = fetch_same_origin(opener, args.form_url, "POST", form, headers, jar, locked, timeout)
            requests.append({"url": args.form_url, "status": login.status, "purpose": "form login"})
            server = header_get(login.headers, "Server")
            aspnet = header_get(login.headers, "X-AspNet-Version")
            if server:
                environment["server"] = server
            if aspnet:
                environment["aspNet"] = aspnet

        page = fetch_same_origin(opener, url, "GET", None, headers, jar, locked, timeout)
        requests.append({"url": page.final_url, "status": page.status, "purpose": "page"})
        server = header_get(page.headers, "Server")
        aspnet = header_get(page.headers, "X-AspNet-Version")
        if server:
            environment["server"] = server
        if aspnet:
            environment["aspNet"] = aspnet
        versions = extract_versions(page.body, page.final_url)
        signals = markup_signals(page.body)
        notes = []
        if page.off_host:
            notes.append("The target URL redirected to a different host. Handler probes stayed on the original host.")
        verdicts = []
        for target in asset_targets(page.body, page.final_url):
            status, content_type, asset_body = fetch_asset(opener, target["url"], timeout)
            requests.append({"url": target["url"], "status": status, "purpose": "asset"})
            verdicts.append(confirm_asset(target, status, content_type, asset_body))
        versions.extend(file_banner_hits(verdicts))
        wall = login_note(page.final_url, page.body)
        if wall:
            notes.append(wall)
        for file_url in version_file_urls(page.final_url, page.body):
            got = fetch_same_origin(opener, file_url, "GET", None, headers, jar, locked, timeout)
            requests.append({"url": file_url, "status": got.status, "purpose": "script"})
            versions.extend(extract_versions(got.body, got.final_url))
            signals.extend(markup_signals(got.body))
        referenced = referenced_bases(page.final_url if not page.off_host else url, page.body)
        parents = directory_bases(page.final_url if not page.off_host else url, not args.no_walk)
        bases = []
        seen = set()
        for base in referenced + parents:
            if base not in seen:
                seen.add(base)
                bases.append(base)
        handlers = []
        app_base = None
        for base in bases:
            handler_id, name, path = HANDLERS[0]
            probe = urllib.parse.urljoin(base, path)
            got = fetch_same_origin(opener, probe, "GET", None, headers, jar, locked, timeout)
            requests.append({"url": probe, "status": got.status, "purpose": handler_id})
            versions.extend(extract_versions(got.body, got.final_url))
            state, detail = classify_handler(handler_id, got.status, got.body)
            row = {"id": handler_id, "name": name, "url": got.final_url, "status": got.status, "state": state, "detail": detail}
            if state == "present":
                app_base = base
                handlers.append(row)
                break
            if base == bases[0]:
                handlers.append(row)
        rest_base = app_base or (bases[0] if bases else None)
        if rest_base:
            for handler_id, name, path in HANDLERS[1:]:
                probe = urllib.parse.urljoin(rest_base, path)
                got = fetch_same_origin(opener, probe, "GET", None, headers, jar, locked, timeout)
                requests.append({"url": probe, "status": got.status, "purpose": handler_id})
                versions.extend(extract_versions(got.body, got.final_url))
                state, detail = classify_handler(handler_id, got.status, got.body)
                handlers.append(
                    {"id": handler_id, "name": name, "url": got.final_url, "status": got.status, "state": state, "detail": detail}
                )
        if rest_base and not any(hit["product"] == "aspnet-ajax" for hit in versions):
            page_text = page.body
            if re.search(r"Telerik|Rad[A-Z]|WebResource\.axd", page_text):
                probe = urllib.parse.urljoin(rest_base, "Telerik.Web.UI.DialogHandler.aspx?DialogName=DocumentManager")
                got = fetch_same_origin(opener, probe, "GET", None, headers, jar, locked, timeout)
                requests.append({"url": probe, "status": got.status, "purpose": "dialog-document"})
                versions.extend(extract_versions(got.body, got.final_url))
        chosen = prefer_handlers(handlers)
        headline = apply_presence(build_headline(versions, verdicts), signals, chosen)
        notes.extend(build_notes(headline, chosen, signals))
        best = {}
        for hit in versions:
            confirmed = any(
                verdict.get("version") == hit["version"] and verdict.get("product") == hit["product"] and verdict.get("state") == "confirmed"
                for verdict in verdicts
            )
            scoreable = hit["method"] in ("assembly", "resource-query", "html-comment", "script-banner", "file-banner") or confirmed
            if not scoreable:
                continue
            current = best.get(hit["product"])
            if current is None or METHOD_RANK.get(hit["method"], 9) < METHOD_RANK.get(current["method"], 9):
                best[hit["product"]] = hit
        advisories = []
        components = []
        for hit in best.values():
            rows = []
            for row in assess_version(hit["version"], hit["product"], chosen):
                if row["status"] != "in-range":
                    continue
                if row.get("requiresHandler"):
                    handler = next((item for item in chosen if item.get("id") == row["requiresHandler"]), None)
                    if not handler or handler.get("state") != "present":
                        continue
                stamped = dict(row)
                stamped["product"] = hit["product"]
                stamped["version"] = hit["version"]
                rows.append(stamped)
            components.append({"product": hit["product"], "version": hit["version"], "method": hit["method"], "advisories": rows})
            advisories.extend(rows)
        if not any(item["product"] == "aspnet-ajax" for item in components) and any(
            row["id"] in ("rau", "dialog") and row["state"] == "present" for row in chosen
        ):
            components.insert(0, {"product": "aspnet-ajax", "version": None, "method": None, "advisories": []})
        elapsed = int((time.time() - started) * 1000)
        return {
            "ok": True,
            "target": url,
            "finalUrl": page.final_url,
            "headline": headline,
            "advisories": advisories,
            "components": components,
            "versions": versions,
            "handlers": chosen,
            "signals": signals,
            "notes": notes,
            "environment": environment,
            "requests": requests,
            "fetched": len(requests),
            "elapsedMs": elapsed,
            "partial": False,
        }
    except ValueError as exc:
        return {"ok": False, "error": str(exc), "target": url, "elapsedMs": int((time.time() - started) * 1000)}
    except urllib.error.URLError as exc:
        reason = exc.reason
        text = str(reason)
        if isinstance(reason, (TimeoutError, socket.timeout)) or "timed out" in text.lower():
            host = urllib.parse.urlsplit(url).hostname or url
            message = "The connection to %s timed out before a page was read." % host
        elif isinstance(reason, ssl.SSLError) or "CERTIFICATE" in text.upper():
            message = "TLS verification failed. Re-run with --insecure only if you trust this host. (%s)" % text
        else:
            message = "The request failed before a version could be read. (%s)" % text
        return {"ok": False, "error": message, "target": url, "elapsedMs": int((time.time() - started) * 1000)}
    except (TimeoutError, socket.timeout) as exc:
        return {
            "ok": False,
            "error": "The connection timed out before a page was read. (%s)" % exc,
            "target": url,
            "elapsedMs": int((time.time() - started) * 1000),
        }
    except Exception as exc:  # noqa: BLE001 — keep the class and message so the next failure is diagnosable
        detail = str(exc).strip() or exc.__class__.__name__
        return {
            "ok": False,
            "error": "The request failed before a version could be read. (%s: %s)" % (exc.__class__.__name__, detail),
            "target": url,
            "elapsedMs": int((time.time() - started) * 1000),
        }


def channel_line(headline: dict) -> str:
    channel = headline.get("channel")
    state = headline.get("assetState")
    if channel == "server":
        return "server-stated"
    if channel == "asset" and state == "confirmed" and headline.get("method") == "file-banner":
        return "file confirmed"
    if channel == "asset" and state == "confirmed":
        return "skin confirmed"
    if channel == "asset" and state == "rejected":
        return "skin path only"
    if channel == "asset" and state == "unconfirmed":
        return "skin inconclusive"
    if channel == "asset":
        return "skin path"
    if channel == "runtime":
        return "script banner"
    return "unread"


def render_text(result: dict) -> str:
    if not result.get("ok"):
        return "error: %s\ntarget: %s" % (result.get("error", "failed"), result.get("target", ""))
    headline = result["headline"]
    lines = [
        "target:  %s" % result["target"],
        "final:   %s" % result.get("finalUrl", ""),
        "version: %s" % (headline.get("version") or "unread"),
        "channel: %s" % channel_line(headline),
        "summary: %s" % headline.get("summary", ""),
    ]
    env = result.get("environment") or {}
    if env.get("server") or env.get("aspNet"):
        lines.append("server:  %s  asp.net: %s" % (env.get("server") or "-", env.get("aspNet") or "-"))
    lines.append("handlers:")
    for row in result.get("handlers") or []:
        lines.append("  %-18s %-8s %s  %s" % (row["name"], row["state"], row["status"], row["detail"]))
    if result.get("components"):
        for component in result["components"]:
            lines.append("component: %s %s" % (component.get("product") or "", component.get("version") or "unread"))
            for row in component.get("advisories") or []:
                lines.append("  %-16s %-13s %s" % (row["id"], row["status"], row["title"]))
    elif result.get("advisories"):
        lines.append("published ranges:")
        seen = None
        for row in result["advisories"]:
            label = "%s %s" % (row.get("product") or "", row.get("version") or "")
            if label != seen:
                seen = label
                lines.append("  %s" % label.strip())
            lines.append("  %-16s %-13s %s" % (row["id"], row["status"], row["title"]))
    if result.get("notes"):
        lines.append("notes:")
        for note in result["notes"]:
            lines.append("  - %s" % note)
    lines.append("requests: %d in %d ms" % (result.get("fetched", 0), result.get("elapsedMs", 0)))
    return "\n".join(lines)


