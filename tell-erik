JQUERY_ASSIGN_RE = re.compile(r"""(?:jQuery\.)?fn\.jquery\s*=\s*["'](\d+\.\d+\.\d+)""", re.I)
JQUERY_UI_ASSIGN_RE = re.compile(r"""(?:jQuery|\$)\.ui\.version\s*=\s*["'](\d+\.\d+\.\d+)""", re.I)
RESOURCE_PARAM_RE = re.compile(r"""(?:\?|&)(?:amp;)?(?:d|_TSM_CombinedScripts_)=([^&"'<\s]{16,4000})""", re.I)
REF_RE = re.compile(
    r"""(?:src|href)\s*=\s*["']([^"']*(?:Telerik\.Web\.UI\.WebResource\.axd|Telerik\.Web\.UI\.DialogHandler\.aspx)[^"']*)["']""",
    re.I,
)


def parse_version(raw: str) -> Optional[Tuple[int, int, int]]:
    match = re.match(r"^(\d{4})\.(\d+)\.(\d+)", raw.strip())
    if not match:
        return None
    return int(match.group(1)), int(match.group(2)), int(match.group(3))


def product_key(version: str) -> Optional[str]:
    parsed = parse_version(version)
    if not parsed:
        return None
    return "%d.%d.%d" % parsed


def compare_product(left: str, right: str) -> int:
    a = parse_version(left)
    b = parse_version(right)
    if not a or not b:
        return 0
    return (a > b) - (a < b)


def clip(value: str, limit: int = 160) -> str:
    flat = re.sub(r"\s+", " ", value).strip()
    if len(flat) <= limit:
        return flat
    return flat[: limit - 1] + "…"


def extract_versions(body: str, source: str) -> List[dict]:
    hits: List[dict] = []
    seen = set()

    def push(version: str, product: str, method: str, evidence: str) -> None:
        key = (product, version, method, source)
        if key in seen:
            return
        seen.add(key)
        hits.append(
            {
                "version": version,
                "product": product,
                "method": method,
                "source": source,
                "evidence": clip(evidence),
            }
        )

    for match in COMMENT_RE.finditer(body):
        push(match.group(1), "aspnet-ajax", "html-comment", match.group(0))
    for match in AJAX_HOST_RE.finditer(body):
        push(match.group(1), "aspnet-ajax", "ajax-cdn", match.group(0))
    for tag in LINK_RE.finditer(body):
        text = tag.group(0)
        if not re.search(r"Telerik_stylesheet", text, re.I):
            continue
        found = AJAX_PATH_RE.search(text)
        if found:
            push(found.group(1), "aspnet-ajax", "ajax-cdn", text)
    for match in KENDO_CDN_RE.finditer(body):
        push(match.group(1), "kendo", "kendo-cdn", match.group(0))
    for match in ASSEMBLY_RE.finditer(body):
        kind = match.group(1).lower()
        if kind.startswith("web.ui"):
            product = "aspnet-ajax"
        elif kind.startswith("reportserver"):
            product = "report-server"
        else:
            product = "reporting"
        method = "resource-query" if "%" in match.group(0) else "assembly"
        push(match.group(2), product, method, match.group(0))
    for match in KENDO_BANNER_RE.finditer(body):
        push(match.group(1), "kendo", "script-banner", match.group(0))
    for match in KENDO_ASSIGN_RE.finditer(body):
        push(match.group(1), "kendo", "script-banner", match.group(0))
    for match in JQUERY_ASSIGN_RE.finditer(body):
        push(match.group(1), "jquery", "script-banner", match.group(0))
    for match in JQUERY_UI_ASSIGN_RE.finditer(body):
        push(match.group(1), "jquery-ui", "script-banner", match.group(0))
    for match in RESOURCE_PARAM_RE.finditer(body):
        raw = match.group(1)
        try:
            cleaned = urllib.parse.unquote(raw).replace("-", "+").replace("_", "/")
        except Exception:
            continue
        if not re.fullmatch(r"[A-Za-z0-9+/=]+", cleaned):
            continue
        try:
            decoded = base64.b64decode(cleaned, validate=False).decode("utf-8")
        except Exception:
            continue
        if re.search(r"[^\t\n\r\x20-\x7e]", decoded[:240]):
            continue
        for inner in ASSEMBLY_RE.finditer(decoded):
            kind = inner.group(1).lower()
            if kind.startswith("web.ui"):
                product = "aspnet-ajax"
            elif kind.startswith("reportserver"):
                product = "report-server"
            else:
                product = "reporting"
            push(inner.group(2), product, "resource-query", inner.group(0))
    return hits


def markup_signals(body: str) -> List[str]:
    signals = []
    if re.search(r"Telerik\.Web\.UI\.WebResource\.axd", body, re.I):
        if re.search(r"[?&]d=", body, re.I):
            signals.append("Page references Telerik.Web.UI.WebResource.axd with an encrypted d parameter.")
        else:
            signals.append("Page references Telerik.Web.UI.WebResource.axd.")
    if re.search(r"Telerik\.Web\.UI\.DialogHandler\.aspx", body, re.I):
        signals.append("Page references DialogHandler.aspx.")
    if re.search(r"Telerik_stylesheet", body, re.I):
        signals.append("Page emits Telerik_stylesheet links.")
    if re.search(r"RadScriptManager", body, re.I):
        signals.append("Page includes RadScriptManager.")
    if re.search(r"kendo\.cdn\.telerik\.com|cdn\.kendostatic\.com", body, re.I):
        signals.append("Page references a Kendo CDN host.")
    return signals


def classify_handler(handler_id: str, status: int, body: str) -> Tuple[str, str]:
    if handler_id == "rau" and re.search(r"RadAsyncUpload handler is registered succes+fully", body, re.I):
        return "present", "Registration message, including the vendor spelling."
    if handler_id == "dialog" and re.search(r"HandlerCheckOK", body, re.I):
        return "present", "HandlerCheckOK"
    if handler_id == "report" and status == 200 and len(body) < 20000 and re.search(
        r"Telerik\.ReportViewer|ReportViewerHandler", body, re.I
    ):
        return "present", "Report viewer marker"
    if status in (404, 410):
        return "absent", "Not found"
    if status in (401, 403):
        return "unknown", "HTTP %d" % status
    if status == 0:
        return "unknown", "No response"
    if status == 200 and len(body) >= 200 and re.search(r"<!doctype html|<html[\s>]|<title>", body, re.I):
        return "unknown", "The response was the application page."
    return "unknown", "HTTP %d, no fingerprint" % status


