def load_advisories():
    root = os.path.dirname(os.path.abspath(__file__))
    for path in (
        os.path.join(root, "definitions.json"),
        os.path.join(root, "extension", "definitions.json"),
    ):
        try:
            with open(path, encoding="utf-8") as handle:
                doc = json.load(handle)
        except OSError:
            continue
        rows = doc.get("advisories") if isinstance(doc, dict) else None
        if isinstance(rows, list) and rows:
            return rows
    return json.loads(EMBEDDED_ADVISORIES)


