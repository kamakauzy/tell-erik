def compare_dotted(left: str, right: str) -> int:
    def parse(value: str):
        parts = []
        for piece in str(value).split("."):
            if not piece.isdigit():
                return None
            parts.append(int(piece))
        return parts

    a = parse(left)
    b = parse(right)
    if a is None or b is None:
        return 0
    length = max(len(a), len(b))
    for index in range(length):
        gap = (a[index] if index < len(a) else 0) - (b[index] if index < len(b) else 0)
        if gap:
            return 1 if gap > 0 else -1
    return 0


def compare_advisory(advisory: dict, version: str, bound: Optional[str]) -> int:
    if not bound:
        return 0
    if advisory.get("scheme") == "dotted":
        return compare_dotted(version, bound)
    return compare_product(version, bound)


def assess_version(version: Optional[str], product: Optional[str], handlers: Optional[Sequence[dict]] = None) -> List[dict]:
    if not version or product not in ("aspnet-ajax", "kendo", "jquery", "jquery-ui", "reporting", "report-server"):
        return []
    rows = []
    for advisory in ADVISORIES:
        if advisory.get("product", "aspnet-ajax") != product:
            continue
        status = "in-range"
        detail = advisory["detail"]
        if advisory.get("requiresHandler") and handlers is not None:
            handler = next((row for row in handlers if row.get("id") == advisory["requiresHandler"]), None)
            if handler and handler.get("state") == "absent":
                status = "outside"
                detail = "%s %s did not answer." % (detail, handler.get("name") or advisory["requiresHandler"])
        if status == "in-range":
            if advisory.get("fixed") and compare_advisory(advisory, version, advisory["fixed"]) >= 0:
                status = "above-fix"
            elif advisory.get("floor") and compare_advisory(advisory, version, advisory["floor"]) < 0:
                status = "outside"
            elif advisory.get("ceiling") and compare_advisory(advisory, version, advisory["ceiling"]) <= 0:
                status = "in-range"
            elif advisory.get("ceiling") and compare_advisory(advisory, version, advisory["ceiling"]) > 0:
                status = "transitional"
        rows.append(
            {
                "id": advisory["id"],
                "title": advisory["title"],
                "status": status,
                "detail": detail,
                "kev": bool(advisory.get("kev")),
                "epss": advisory.get("epss"),
                "requiresHandler": advisory.get("requiresHandler"),
            }
        )
    order = {"in-range": 0, "transitional": 1, "unplaced": 2, "outside": 3, "above-fix": 4}
    rows.sort(key=lambda row: order[row["status"]])
    return rows


