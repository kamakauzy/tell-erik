{
  "manifest_version": 3,
  "name": "tell-erik",
  "version": "0.1.0",
  "description": "Read the Telerik UI build on the current tab.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "tell-erik",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
