{
  "manifest_version": 3,
  "name": "tell-erik",
  "version": "0.3.1",
  "description": "A SecurIT360 tool. Read the Telerik UI build on the current tab.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://d35islomi5rx1v.cloudfront.net/*",
    "https://kendo.cdn.telerik.com/*",
    "https://cdn.kendostatic.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "tell-erik",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
